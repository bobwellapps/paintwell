[Desktop Entry]
Type=Application
Name=Paintwell
GenericName=Image Editor
Comment=A friendly, capable image editor
Exec=paintwell %F
Icon=${SNAP}/meta/gui/paintwell.png
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/png;image/jpeg;image/bmp;image/gif;image/webp;image/tiff;image/openraster;
Keywords=paint;draw;photo;image;editor;layers;
StartupWMClass=paintwell
